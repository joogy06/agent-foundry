{
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(*intake.py override*)",
      "Bash(*intake.py triage*)",
      "Bash(*intake.py except*)",
      "Bash(*mailscan.py override*)",
      "Bash(*mailscan*override*)",
      "Edit(~/.foundry/mail-scan/**)"
    ],
    "deny": [
      "Read(~/.foundry/quarantine/**)",
      "Read(~/.foundry/mail-scan/views/**)",
      "Read(~/.foundry/mail-scan/key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/_meta/scan_hard_rules.py --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/_meta/forge_reminder_hook.py --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/cross-project-mail/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/_meta/freshness_nudge.py --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/_meta/scope_delta_compact_nudge.py --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/_meta/memory_primer.py --hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "skillListingBudgetFraction": 0.03
}
