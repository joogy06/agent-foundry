{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foundry-lab.local/schemas/wiring-snapshot.v1.json",
  "title": "wiring-snapshot.v1",
  "description": "Reconciled snapshot, single JSON, per design 2026-04-14 §4.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "snapshot_id", "snapshot_generation", "run_id",
    "workspace_tree_hash", "generated_at", "generated_by",
    "source_statuses", "edges"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "snapshot_generation": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "format": "uuid" },
    "workspace_tree_hash": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "contract_map_hash": { "type": "string" },
    "contract_map_revision": { "type": "integer" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generated_by": { "const": "wiring-reconcile@1.0.0" },
    "source_statuses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["succeeded", "failed", "partial", "skipped"] },
          "edge_count": { "type": "integer", "minimum": 0 },
          "last_seen_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id", "src_component", "src_symbol", "dst_component",
          "dst_symbol", "edge_kind", "status", "evidence",
          "blocking_eligible"
        ],
        "properties": {
          "edge_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
          "src_component": { "type": "string" },
          "src_symbol":    { "type": "string" },
          "dst_component": { "type": "string" },
          "dst_symbol":    { "type": "string" },
          "edge_kind":     { "type": "string" },
          "callsite_refs": {
            "type": "array",
            "items": { "type": "object" }
          },
          "status": { "enum": ["live", "stale", "orphan", "suppressed"] },
          "blocking_eligible": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_source", "extractor_id", "last_seen_at", "workspace_tree_hash"],
              "properties": {
                "evidence_source": { "enum": ["static_extract", "agent_asserted", "manual"] },
                "extractor_id": { "type": "string" },
                "extractor_version": { "type": "string" },
                "last_seen_at": { "type": "string", "format": "date-time" },
                "workspace_tree_hash": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "last_seen_by_source": {
            "type": "object",
            "additionalProperties": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "inbound_edge_count":  { "type": "integer", "minimum": 0 },
          "outbound_edge_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "statistics": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm":     { "const": "HMAC-SHA256" },
        "key_id":        { "type": "string" },
        "signed_at":     { "type": "string", "format": "date-time" },
        "signed_fields": { "type": "array", "items": { "type": "string" } },
        "digest":        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
