{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake-verdict.v1",
  "title": "Intake scan verdict record",
  "description": "One record per scan. It carries rule ids, classes, opaque file ids, line numbers, counts and digests. It never carries a file name or a line of content from the scanned target: those go to triage.md in the quarantine directory. The only free text is `subject.source.target` (the target as the caller typed it) and the reasons a person wrote in `review`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "created", "verdict", "reasons", "subject", "inventory_digest", "versions", "isolation", "findings", "coverage", "gaps", "evidence", "counts", "review"],
  "properties": {
    "schema": {"const": "intake-verdict.v1"},
    "id": {"$ref": "#/$defs/id"},
    "created": {"$ref": "#/$defs/time"},
    "verdict": {"enum": ["pass", "caution", "block"]},
    "rejected": {"type": "boolean"},
    "reasons": {
      "type": "array",
      "items": {"enum": ["block-rule-hit", "required-scanner-gap", "blocking-gap", "caution-finding", "info-finding", "optional-gap"]}
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "commit", "tree_digest"],
      "properties": {
        "kind": {"enum": ["skill", "repo"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "properties": {
            "type": {"enum": ["git", "folder", "zip", "local", "unknown"]},
            "target": {"type": "string", "maxLength": 2000},
            "ref": {"type": ["string", "null"], "maxLength": 200}
          }
        },
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "tree_digest": {"$ref": "#/$defs/hex64"},
        "unit": {"type": "string", "pattern": "^(skills|agents|commands|workflows)/[A-Za-z0-9._@+-]{1,120}$"}
      }
    },
    "inventory_digest": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "policy", "tools"],
      "properties": {
        "rules": {"$ref": "#/$defs/word"},
        "policy": {"$ref": "#/$defs/word"},
        "tools": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"type": ["string", "null"], "pattern": "^[0-9A-Za-z][0-9A-Za-z.+!-]{0,39}$"}
        }
      }
    },
    "isolation": {"enum": ["bwrap", "none", "not-run"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "class", "file", "line", "scanner"],
        "properties": {
          "rule": {"$ref": "#/$defs/rule"},
          "class": {"enum": ["block", "caution", "info"]},
          "file": {"$ref": "#/$defs/file"},
          "line": {"type": "integer", "minimum": 0},
          "scanner": {"$ref": "#/$defs/name"},
          "excepted": {"type": "boolean"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "uncovered", "partial", "language_gap", "scanners"],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entries", "stored", "omitted"],
          "properties": {
            "entries": {"type": "integer", "minimum": 0},
            "stored": {"type": "integer", "minimum": 0},
            "omitted": {"type": "integer", "minimum": 0}
          }
        },
        "uncovered": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "partial": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "language_gap": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "scanners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scanner", "state", "required", "isolation", "files_inspected", "files_partial"],
            "properties": {
              "scanner": {"$ref": "#/$defs/name"},
              "state": {"enum": ["ran", "not-run", "not-needed"]},
              "required": {"type": "boolean"},
              "isolation": {"enum": ["bwrap", "none", "in-process", "not-run"]},
              "files_inspected": {"type": "integer", "minimum": 0},
              "files_partial": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap", "scanner", "effect", "files", "count"],
        "properties": {
          "gap": {"$ref": "#/$defs/name"},
          "scanner": {"$ref": "#/$defs/name"},
          "effect": {"enum": ["block", "caution"]},
          "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
          "count": {"type": "integer", "minimum": 0},
          "reasons": {"type": "array", "items": {"$ref": "#/$defs/name"}}
        }
      }
    },
    "evidence": {
      "description": "What each scanner reported about its own run. Stored for a person to read. Never an input to the verdict.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"$ref": "#/$defs/word"},
        "additionalProperties": {
          "anyOf": [
            {"type": ["number", "null", "boolean"]},
            {"$ref": "#/$defs/word"},
            {
              "type": "object",
              "propertyNames": {"$ref": "#/$defs/word"},
              "additionalProperties": {"type": ["number", "null"]}
            }
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "gaps"],
      "properties": {
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["block", "caution", "info", "excepted"],
          "properties": {
            "block": {"type": "integer", "minimum": 0},
            "caution": {"type": "integer", "minimum": 0},
            "info": {"type": "integer", "minimum": 0},
            "excepted": {"type": "integer", "minimum": 0}
          }
        },
        "gaps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["block", "caution"],
          "properties": {
            "block": {"type": "integer", "minimum": 0},
            "caution": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "reason", "time"],
        "properties": {
          "action": {"enum": ["override", "triage-accept", "triage-reject", "adopt"]},
          "reason": {"type": "string", "maxLength": 2000},
          "time": {"$ref": "#/$defs/time"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "word": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,49}$"},
    "rule": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,7}(-[A-Za-z0-9][A-Za-z0-9-]{0,23})?$"},
    "file": {"type": "string", "pattern": "^(f[0-9]{3,7}|-)$"}
  }
}
