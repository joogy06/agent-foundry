#!/usr/bin/env python3
"""cpmail — cross-project-mail CLI (v1, M1 walking skeleton).

Flat-file mailbox at ~/.ai-mailbox/. Single file, stdlib + pyyaml only.
No daemon, no MCP server, no upstream dependency. v1 trust model is
single-user single-host; HMAC/quarantine/sender-allowlist deferred to v2 (M3).

See skill: ~/.claude/skills/cross-project-mail/SKILL.md
See design: docs/plans/2026-05-16-cross-project-mail-v1-design.md
"""
import argparse
import datetime as _dt
import errno
import hashlib
import json
import os
import random
import re
import signal
import socket
import sys
import tempfile
import time
from pathlib import Path
from typing import Optional

try:
    import yaml
except ImportError:
    sys.exit("cpmail: pyyaml required. Install: pip install --user pyyaml")

# Advisory file locks: fcntl is POSIX-only and msvcrt Windows-only, so each is
# imported conditionally and neither import can take the CLI down elsewhere.
try:
    import fcntl
except ImportError:  # Windows
    fcntl = None
try:
    import msvcrt
except ImportError:  # POSIX
    msvcrt = None

SCHEMA_VERSION = "1"
ULID_PAT = re.compile(r"^[0-9A-HJKMNP-TV-Z]{26}$")
PROJECT_PAT = re.compile(r"^[a-z0-9_-]{1,64}$")
LABEL_PAT = re.compile(r"^[a-z0-9_-]{1,40}$")
SOURCE_TYPES = {"human", "ai_summary", "web_fetch_quoted", "tool_output"}
ACK_STATES = {"unread", "read", "acked"}
AGENTS = {"claude_code", "codex_cli", "gemini_cli", "copilot_chat", "copilot_cli",
          "human", "forge", "bob", "alf", "pa", "wiki", "unknown"}
BODY_CAP_BYTES = 16 * 1024
SUBJECT_CAP = 200
CROCKFORD = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
EXIT_DUPLICATE = 4  # send --dedupe refused: an unacked message on the topic exists
DEDUPE_LOCK_WAIT_S = 10.0   # how long a --dedupe send waits for its topic lock
DEDUPE_LOCK_STALE_S = 60.0  # a topic lock older than this is a crashed sender's
EXIT_WATCHING = 3           # watch-loop: another loop already holds this project+session
WATCH_DEFAULT_INTERVAL_S = 600.0
WATCH_MIN_INTERVAL_S = 30.0
CONFIG_LOCK_WAIT_S = 10.0
FRONTMATTER_CAP_BYTES = 4096   # state reads parse only this much of a message
SESSION_PAT = re.compile(r"^[A-Za-z0-9._-]{1,128}$")
# yaml.safe_load semantics; the libyaml-backed loader when present keeps the
# SessionStart hook inside its budget on an inbox of a few hundred messages.
_SAFE_LOADER = getattr(yaml, "CSafeLoader", yaml.SafeLoader)
_ACK_LINE = re.compile(r"^ack_state:[ \t]*([A-Za-z]+)[ \t]*\r?$", re.MULTILINE)


# ---------------------------------------------------------------- ULID
def ulid() -> str:
    """Generate a Crockford-Base32 ULID (26 chars, 128 bits, k-sortable)."""
    n = (int(time.time() * 1000) << 80) | random.getrandbits(80)
    out = []
    for _ in range(26):
        out.append(CROCKFORD[n & 0x1F])
        n >>= 5
    return "".join(reversed(out))


def ulid_from(seed: str) -> str:
    """Deterministic ULID derived from seed (for idempotent migrator)."""
    h = hashlib.sha256(seed.encode()).digest()
    n = int.from_bytes(h[:16], "big")
    out = []
    for _ in range(26):
        out.append(CROCKFORD[n & 0x1F])
        n >>= 5
    return "".join(reversed(out))


# ---------------------------------------------------------------- Paths
def mailbox_root() -> Path:
    return Path(os.environ.get("AI_MAILBOX", str(Path.home() / ".ai-mailbox"))).expanduser()


def inbox_dir(project: str) -> Path:
    return mailbox_root() / "inbox" / project


def acked_dir(project: str) -> Path:
    return mailbox_root() / "inbox" / project / ".acked"


def outbox_dir(project: str) -> Path:
    return mailbox_root() / "outbox" / project


def ensure_layout(project: str) -> None:
    for p in (inbox_dir(project), acked_dir(project), outbox_dir(project)):
        p.mkdir(parents=True, exist_ok=True)


# ---------------------------------------------------------------- Validation
class ValidationError(Exception):
    pass


def validate(env: dict) -> None:
    required = {"schema_version", "msg_id", "sent_at", "sender", "recipient",
                "subject", "source_type", "ack_state"}
    missing = required - env.keys()
    if missing:
        raise ValidationError(f"missing required fields: {sorted(missing)}")
    if env["schema_version"] != SCHEMA_VERSION:
        raise ValidationError(f"unsupported schema_version: {env['schema_version']}")
    if not ULID_PAT.match(env["msg_id"] or ""):
        raise ValidationError(f"invalid msg_id: {env['msg_id']!r}")
    try:
        _dt.datetime.fromisoformat(env["sent_at"].replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        raise ValidationError(f"invalid sent_at: {env['sent_at']!r}")

    sender = env["sender"]
    if not isinstance(sender, dict) or not PROJECT_PAT.match(sender.get("project") or ""):
        raise ValidationError("invalid sender.project")
    if sender.get("agent") not in AGENTS:
        raise ValidationError(f"invalid sender.agent: {sender.get('agent')!r}")

    recipient = env["recipient"]
    if not isinstance(recipient, dict) or not PROJECT_PAT.match(recipient.get("project") or ""):
        raise ValidationError("invalid recipient.project")
    rec_agent = recipient.get("agent")
    if rec_agent is not None and not isinstance(rec_agent, str):
        raise ValidationError("invalid recipient.agent")

    subj = env["subject"]
    if not isinstance(subj, str) or not (1 <= len(subj) <= SUBJECT_CAP):
        raise ValidationError(f"subject must be 1-{SUBJECT_CAP} chars")
    if env["source_type"] not in SOURCE_TYPES:
        raise ValidationError(f"invalid source_type: {env['source_type']!r}")
    if env["ack_state"] not in ACK_STATES:
        raise ValidationError(f"invalid ack_state: {env['ack_state']!r}")

    for label in (env.get("labels") or []):
        if not LABEL_PAT.match(label or ""):
            raise ValidationError(f"invalid label: {label!r}")

    for k in ("reply_to", "thread_id"):
        v = env.get(k)
        if v is not None and not ULID_PAT.match(v):
            raise ValidationError(f"invalid {k}: {v!r}")

    dk = env.get("dedupe_key")
    if dk is not None and not (isinstance(dk, str) and 1 <= len(dk) <= SUBJECT_CAP):
        raise ValidationError(f"dedupe_key must be 1-{SUBJECT_CAP} chars")

    known = {"schema_version", "msg_id", "sent_at", "sender", "recipient",
             "subject", "source_type", "reply_to", "thread_id", "labels",
             "ack_state", "attachments", "dedupe_key"}
    unknown = env.keys() - known
    if unknown:
        print(f"cpmail: warning: unknown envelope fields ignored: {sorted(unknown)}",
              file=sys.stderr)


# ---------------------------------------------------------------- Serialization
def dump_message(env: dict, body: str) -> str:
    fm = yaml.safe_dump(env, sort_keys=False, default_flow_style=False, allow_unicode=True)
    return f"---\n{fm}---\n\n{body}\n"


def load_message(path: Path) -> tuple[dict, str]:
    text = path.read_text(encoding="utf-8")
    m = re.match(r"\A---\n(.*?\n)---\n+(.*)\Z", text, re.DOTALL)
    if not m:
        raise ValidationError(f"{path.name}: missing frontmatter")
    env = yaml.safe_load(m.group(1)) or {}
    return env, m.group(2)


# ---------------------------------------------------------------- Atomic writes
def atomic_write_text(path: Path, text: str, mode: int = 0o600) -> None:
    """Write text to path so a reader sees the old file or the whole new one,
    never a partial one (A6). The temp file is a dot-file in the same directory,
    which every inbox scan skips and which keeps os.replace on one filesystem."""
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------- Project detect
def detect_project(cwd: Optional[Path] = None) -> Optional[str]:
    cwd = (cwd or Path.cwd()).resolve()

    # Tier 1: ~/.ai-mailbox/.config.yaml project_aliases
    cfg_path = mailbox_root() / ".config.yaml"
    if cfg_path.exists():
        try:
            cfg = yaml.safe_load(cfg_path.read_text(encoding="utf-8")) or {}
            # Match whole path components, so an alias for .../trading covers
            # .../trading/src but not the sibling .../trading02; the deepest
            # matching alias wins.
            best = None
            for path_pat, project in (cfg.get("project_aliases") or {}).items():
                alias = Path(path_pat).expanduser().resolve()
                if (cwd == alias or alias in cwd.parents) and PROJECT_PAT.match(project or ""):
                    if best is None or len(alias.parts) > len(best[0].parts):
                        best = (alias, project)
            if best:
                return best[1]
        except (yaml.YAMLError, OSError):
            pass

    # Tier 2: PROJECT.md first heading (slug-cased)
    p = cwd / "PROJECT.md"
    if p.exists():
        try:
            for line in p.read_text(encoding="utf-8").splitlines():
                s = line.strip()
                if s.startswith("# "):
                    name = s[2:].strip().lower().replace(" ", "_")
                    if PROJECT_PAT.match(name):
                        return name
                    break
        except OSError:
            pass

    # Tier 3: CWD basename if slug-shaped
    base = cwd.name
    if PROJECT_PAT.match(base):
        return base
    return None


# ---------------------------------------------------------------- Dedupe
def normalise_key(text: str) -> str:
    """Casefold and collapse whitespace: the dedupe key of a subject or --dedupe-key."""
    return " ".join((text or "").split()).casefold()


def find_unacked_duplicate(sender_project: str, recipient: str, key: str) -> Optional[str]:
    """msg_id of an unacked message from sender_project to recipient whose dedupe
    key equals key, else None. Acked messages leave the active inbox, so a topic
    reopens once the recipient acks. A message with no recorded key (sent without
    --dedupe) is keyed by its normalised subject."""
    for f in list_active(recipient):
        try:
            env, _ = load_message(f)
        except (ValidationError, yaml.YAMLError, OSError):
            continue
        if (env.get("sender") or {}).get("project") != sender_project:
            continue
        if env.get("ack_state") == "acked":
            continue
        existing = env.get("dedupe_key") or normalise_key(env.get("subject") or "")
        if existing == key:
            return env.get("msg_id") or f.stem
    return None


def dedupe_lock_path(sender_project: str, recipient: str, key: str) -> Path:
    digest = hashlib.sha256(f"{sender_project}\0{recipient}\0{key}".encode()).hexdigest()
    return mailbox_root() / ".locks" / f"dedupe-{digest[:32]}.lock"


class DedupeLock:
    """Per (sender, recipient, key) mutex held across the duplicate scan and the
    write, so concurrent --dedupe sends on one topic write exactly one message.
    The lock is a file created with O_CREAT|O_EXCL, which is atomic on POSIX and
    Windows alike; it is removed on exit. A lock older than DEDUPE_LOCK_STALE_S
    is left by a crashed sender and is broken."""

    def __init__(self, path: Path):
        self.path = path
        self.held = False

    def __enter__(self) -> "DedupeLock":
        self.path.parent.mkdir(parents=True, exist_ok=True)
        deadline = time.monotonic() + DEDUPE_LOCK_WAIT_S
        while True:
            try:
                fd = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            except FileExistsError:
                self._break_if_stale()
                if time.monotonic() >= deadline:
                    raise TimeoutError(f"dedupe lock busy: {self.path}")
                time.sleep(random.uniform(0.01, 0.05))
                continue
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(f"{os.getpid()} {socket.gethostname()[:64]}\n")
            self.held = True
            return self

    def _break_if_stale(self) -> None:
        try:
            if time.time() - self.path.stat().st_mtime < DEDUPE_LOCK_STALE_S:
                return
            # Move the lock aside, then check what was moved: if a second breaker
            # got here after the first one had already broken it and taken a
            # fresh lock, the moved file is live and is put back (link() never
            # overwrites). Residual: only after a crash, with three or more
            # senders racing inside this window.
            grave = self.path.with_name(f"{self.path.name}.stale-{os.getpid()}-{random.getrandbits(32):08x}")
            os.replace(self.path, grave)
            if time.time() - grave.stat().st_mtime < DEDUPE_LOCK_STALE_S:
                try:
                    os.link(grave, self.path)
                except OSError:
                    pass
            os.unlink(grave)
        except OSError:
            pass

    def __exit__(self, *exc) -> None:
        if self.held:
            try:
                os.unlink(self.path)
            except OSError:
                pass
            self.held = False


# ---------------------------------------------------------------- Commands
def cmd_send(args: argparse.Namespace) -> int:
    if not PROJECT_PAT.match(args.to):
        print(f"cpmail: invalid --to project slug: {args.to!r}", file=sys.stderr)
        return 2
    if not args.subject or len(args.subject) > SUBJECT_CAP:
        print(f"cpmail: --subject required, 1-{SUBJECT_CAP} chars", file=sys.stderr)
        return 2

    if args.from_ and args.from_.startswith("@"):
        body = Path(args.from_[1:]).expanduser().read_text(encoding="utf-8")
    else:
        body = sys.stdin.read()
    body = body.rstrip("\n")
    if len(body.encode("utf-8")) > BODY_CAP_BYTES:
        print(f"cpmail: body exceeds {BODY_CAP_BYTES} bytes", file=sys.stderr)
        return 2

    sender_project = args.from_project or detect_project()
    if not sender_project:
        print("cpmail: cannot detect sender project; pass --from-project", file=sys.stderr)
        return 2

    dedupe_key = None
    if args.dedupe or args.dedupe_key is not None:
        dedupe_key = normalise_key(args.subject if args.dedupe_key is None else args.dedupe_key)
        if not dedupe_key or len(dedupe_key) > SUBJECT_CAP:
            print(f"cpmail: --dedupe-key must be 1-{SUBJECT_CAP} chars", file=sys.stderr)
            return 2
        try:
            with DedupeLock(dedupe_lock_path(sender_project, args.to, dedupe_key)):
                dup = find_unacked_duplicate(sender_project, args.to, dedupe_key)
                if dup:
                    print(f"cpmail: duplicate: unacked message {dup} to {args.to} already has "
                          f"dedupe key {dedupe_key!r}; not sent", file=sys.stderr)
                    return EXIT_DUPLICATE
                return _write_message(args, body, sender_project, dedupe_key)
        except TimeoutError as e:
            print(f"cpmail: {e}; not sent", file=sys.stderr)
            return 1
    return _write_message(args, body, sender_project, None)


def _write_message(args: argparse.Namespace, body: str, sender_project: str,
                   dedupe_key: Optional[str]) -> int:
    mid = ulid()
    env = {
        "schema_version": SCHEMA_VERSION,
        "msg_id": mid,
        "sent_at": _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "sender": {"project": sender_project, "agent": args.sender_agent,
                   "host": socket.gethostname()[:64]},
        "recipient": {"project": args.to, "agent": args.agent},
        "subject": args.subject,
        "source_type": args.source_type,
        "reply_to": args.reply_to,
        "thread_id": args.thread_id or mid,
        "labels": args.label or [],
        "ack_state": "unread",
        "attachments": [],
    }
    if dedupe_key is not None:
        env["dedupe_key"] = dedupe_key
    validate(env)

    ensure_layout(args.to)
    ensure_layout(sender_project)
    out = inbox_dir(args.to) / f"{mid}.md"
    if out.exists():
        print(f"cpmail: msg_id collision: {mid}", file=sys.stderr)
        return 1
    atomic_write_text(out, dump_message(env, body))

    # outbox symlink (advisory; ignore failures on weird filesystems)
    out_link = outbox_dir(sender_project) / f"{mid}.md"
    if not out_link.exists():
        try:
            out_link.symlink_to(os.path.relpath(out, out_link.parent))
        except (OSError, NotImplementedError):
            pass

    print(mid)
    return 0


def _message_files(d: Path) -> list[Path]:
    """Message files directly under d. Dot-files (in-flight temp files among them)
    and *.tmp are never messages; a directory that vanished lists as empty."""
    try:
        entries = list(d.iterdir())
    except OSError:
        return []
    out = []
    for p in entries:
        if p.name.startswith(".") or p.suffix != ".md":
            continue
        try:
            if p.is_file():
                out.append(p)
        except OSError:
            continue
    return sorted(out)


def list_active(project: str) -> list[Path]:
    return _message_files(inbox_dir(project))


def list_acked(project: str) -> list[Path]:
    return _message_files(acked_dir(project))


def read_state(path: Path) -> Optional[str]:
    """ack_state of a message from its frontmatter alone (A7): the first
    FRONTMATTER_CAP_BYTES are read and the block parsed with yaml safe loading (a
    single plain top-level `ack_state:` line, which is what cpmail writes, is taken
    directly, to keep the hook inside its budget). A file
    that vanished returns None (absent); a missing or invalid state is 'unread', so
    a damaged message is surfaced rather than hidden."""
    try:
        with open(path, "rb") as f:
            head = f.read(FRONTMATTER_CAP_BYTES)
    except FileNotFoundError:
        return None
    except OSError:
        return "unread"
    try:
        text = head.decode("utf-8", errors="replace")
        m = re.match(r"\A---\r?\n(.*?\r?\n)---\r?\n", text, re.DOTALL)
        if not m:
            return "unread"
        block = m.group(1)
        # Fast path: cpmail writes exactly one top-level `ack_state: <state>` line.
        # Anything less plain goes through the YAML parser.
        hits = _ACK_LINE.findall(block)
        if len(hits) == 1 and hits[0] in ACK_STATES:
            return hits[0]
        env = yaml.load(block, Loader=_SAFE_LOADER)
        state = env.get("ack_state") if isinstance(env, dict) else None
    except yaml.YAMLError:
        state = None
    return state if state in ACK_STATES else "unread"


def state_counts(project: str) -> tuple[int, int]:
    """(new, read-but-not-acked) for the project's active inbox."""
    new = read = 0
    for f in list_active(project):
        st = read_state(f)
        if st == "unread":
            new += 1
        elif st == "read":
            read += 1
    return new, read


def format_row(env: dict) -> str:
    sender = env.get("sender") or {}
    return (f"{env.get('msg_id', '?')}\t{env.get('ack_state', '?')}\t"
            f"{env.get('sent_at', '?')}\t"
            f"{sender.get('project', '?')}/{sender.get('agent', '?')}\t"
            f"{env.get('source_type', '?')}\t{env.get('subject', '')}")


def new_message_rows(project: str) -> list[str]:
    """list rows of the project's messages in state 'unread'."""
    rows = []
    for f in list_active(project):
        if read_state(f) != "unread":
            continue
        try:
            env, _ = load_message(f)
        except (ValidationError, yaml.YAMLError, OSError):
            env = {"msg_id": f.stem, "ack_state": "unread", "subject": "(unparseable message)"}
        rows.append(format_row(env))
    return rows


def cmd_list(args: argparse.Namespace) -> int:
    project = args.project or detect_project()
    if not project:
        print("cpmail: cannot detect project; pass --project", file=sys.stderr)
        return 2

    # Default to unread (= everything not acked) when no flag given
    if args.acked:
        state = "acked"
    elif args.all:
        state = "all"
    else:
        state = "unread"

    if state == "unread":
        files = list_active(project)
    elif state == "acked":
        files = list_acked(project)
    else:
        files = list_active(project) + list_acked(project)

    since = None
    if args.since:
        try:
            since = _dt.datetime.fromisoformat(args.since.replace("Z", "+00:00"))
        except ValueError:
            print(f"cpmail: invalid --since (use RFC3339): {args.since}", file=sys.stderr)
            return 2

    rows = []
    for f in files:
        try:
            env, _ = load_message(f)
        except (ValidationError, yaml.YAMLError, OSError):
            continue  # unparseable, or vanished between listing and reading
        if args.new and env.get("ack_state") != "unread":
            continue
        if since:
            try:
                sa = _dt.datetime.fromisoformat(env["sent_at"].replace("Z", "+00:00"))
                if sa < since:
                    continue
            except (ValueError, KeyError):
                continue
        rows.append(env)
        if args.limit and len(rows) >= args.limit:
            break

    for env in rows:
        print(format_row(env))
    return 0


def find_file(mid: str, project: Optional[str] = None) -> Optional[Path]:
    if not ULID_PAT.match(mid or ""):
        return None
    root = mailbox_root() / "inbox"
    if not root.exists():
        return None
    projects = [project] if project else sorted(p.name for p in root.iterdir() if p.is_dir())
    for proj in projects:
        for state_dir in (inbox_dir(proj), acked_dir(proj)):
            p = state_dir / f"{mid}.md"
            if p.exists():
                return p
    return None


_FRAME_TAG = re.compile(r"<(\s*/?\s*user_data\b)", re.IGNORECASE)


def _neutralise_frame_tags(text: str) -> str:
    """Make a `<user_data>` or `</user_data>` tag inside sender text inert (#353).

    `cpmail read` frames the body as untrusted data. A body that carries the closing
    tag would end that frame early, and the text after it would read as trusted, so
    the tag's `<` is written as `&lt;`. Only the frame's own tag is touched."""
    return _FRAME_TAG.sub(r"&lt;\1", text)


def cmd_read(args: argparse.Namespace) -> int:
    p = find_file(args.msg_id)
    if not p:
        print(f"cpmail: message not found: {args.msg_id}", file=sys.stderr)
        return 3
    try:
        env, body = load_message(p)
    except (ValidationError, yaml.YAMLError) as e:
        print(f"cpmail: corrupted message {args.msg_id}: {e}", file=sys.stderr)
        return 1

    # Auto-bump unread -> read on first read (preserves audit trail in body)
    if env.get("ack_state") == "unread" and ".acked" not in p.parts:
        env["ack_state"] = "read"
        atomic_write_text(p, dump_message(env, body))

    print(f"--- message {env['msg_id']} ---")
    for k in ("sent_at", "sender", "recipient", "subject", "source_type",
              "reply_to", "thread_id", "labels", "ack_state"):
        v = env.get(k)
        if v is None or v == [] or v == {}:
            continue
        if isinstance(v, (dict, list)):
            v = json.dumps(v, separators=(",", ":"))
        print(f"{k}: {_neutralise_frame_tags(str(v))}")
    print()
    print("<user_data>")
    print(_neutralise_frame_tags(body))
    print("</user_data>")
    return 0


def cmd_ack(args: argparse.Namespace) -> int:
    p = find_file(args.msg_id)
    if not p:
        print(f"cpmail: message not found: {args.msg_id}", file=sys.stderr)
        return 3
    if ".acked" in p.parts:
        print(f"cpmail: already acked: {args.msg_id}", file=sys.stderr)
        return 0

    try:
        env, body = load_message(p)
    except (ValidationError, yaml.YAMLError) as e:
        print(f"cpmail: corrupted message {args.msg_id}: {e}", file=sys.stderr)
        return 1

    env["ack_state"] = "acked"
    project = env["recipient"]["project"]
    target = acked_dir(project) / p.name
    target.parent.mkdir(parents=True, exist_ok=True)
    atomic_write_text(target, dump_message(env, body))
    try:
        p.unlink()
    except FileNotFoundError:
        pass
    print(f"acked: {args.msg_id}")
    return 0


def _extract_recipients(section_heading: str, sender_project: str) -> list[str]:
    """From '## Outbound — foundry-lab → vs-code-foundry (...)' return recipients.
    Ignores Inbound sections (those are the receiving side's view, already
    covered by the SENDING side's Outbound entry on the other end).
    """
    h = re.sub(r"^##\s*", "", section_heading or "")
    if "outbound" not in h.lower():
        return []
    m = re.search(r"(?:→|->)\s*(.+)$", h)
    if not m:
        return []
    rhs = m.group(1).strip().strip("[](){}")
    out = []
    for piece in re.split(r"[,/]+", rhs):
        s = piece.strip().lower()
        sm = re.match(r"^([a-z0-9_-]+)", s)
        if sm:
            slug = sm.group(1).rstrip("-_")
            if slug and slug != sender_project and PROJECT_PAT.match(slug):
                out.append(slug)
    return out


def cmd_migrate(args: argparse.Namespace) -> int:
    src = Path(args.from_).expanduser().resolve()
    if not src.exists():
        print(f"cpmail: source not found: {src}", file=sys.stderr)
        return 3

    sender_project = args.sender_project or src.parent.name
    if not PROJECT_PAT.match(sender_project):
        print(f"cpmail: invalid sender project: {sender_project!r}", file=sys.stderr)
        return 2

    text = src.read_text(encoding="utf-8")
    # Split on `^## ` headings to enumerate sections (Outbound/Inbound/Decisions)
    sections = re.split(r"(?m)^(##\s.+)$", text)
    section_pairs = []  # list[(heading, content_below)]
    if len(sections) > 1:
        for i in range(1, len(sections), 2):
            content = sections[i + 1] if i + 1 < len(sections) else ""
            section_pairs.append((sections[i], content))
    else:
        section_pairs.append(("", text))

    written = 0
    skipped_existing = 0

    for heading, content in section_pairs:
        recipients = _extract_recipients(heading, sender_project)
        if not recipients:
            continue

        # Each entry begins at `^### YYYY-MM-DD`
        # We capture date AND the full original header line for the subject
        entry_pat = re.compile(r"(?m)^### (\d{4}-\d{2}-\d{2})([^\n]*)\n")
        positions = [(m.start(), m.group(1), m.group(2)) for m in entry_pat.finditer(content)]
        if not positions:
            continue

        for idx, (pos, date_str, title_rest) in enumerate(positions):
            end = positions[idx + 1][0] if idx + 1 < len(positions) else len(content)
            entry_body = content[pos:end]
            # Drop the `### <date> <title>` line itself from body
            entry_body = entry_pat.sub("", entry_body, count=1).strip()
            title = (title_rest.strip(" —-") or date_str)[:SUBJECT_CAP]

            for recipient in recipients:
                seed = f"{src}::{date_str}::{recipient}::{sender_project}::{title}"
                mid = ulid_from(seed)
                if find_file(mid):
                    skipped_existing += 1
                    continue

                env = {
                    "schema_version": SCHEMA_VERSION,
                    "msg_id": mid,
                    "sent_at": f"{date_str}T00:00:00Z",
                    "sender": {"project": sender_project, "agent": "human",
                               "host": socket.gethostname()[:64]},
                    "recipient": {"project": recipient, "agent": None},
                    "subject": title,
                    "source_type": "human",
                    "reply_to": None,
                    "thread_id": mid,
                    "labels": ["cross-repo-review", "migrated"],
                    "ack_state": "unread",
                    "attachments": [{"kind": "file_ref", "ref": str(src), "sha256": None}],
                }
                validate(env)
                wrapped = "<quoted_legacy_content>\n" + entry_body + "\n</quoted_legacy_content>"

                if args.dry_run:
                    print(f"DRY: {mid} sender={sender_project} recipient={recipient} "
                          f"date={date_str} subject={title!r}")
                else:
                    ensure_layout(recipient)
                    ensure_layout(sender_project)
                    out = inbox_dir(recipient) / f"{mid}.md"
                    atomic_write_text(out, dump_message(env, wrapped))
                    out_link = outbox_dir(sender_project) / f"{mid}.md"
                    if not out_link.exists():
                        try:
                            out_link.symlink_to(os.path.relpath(out, out_link.parent))
                        except (OSError, NotImplementedError):
                            pass
                    print(f"wrote {mid} recipient={recipient} date={date_str}")
                written += 1

    print(f"migrate: wrote={written} skipped_existing={skipped_existing}", file=sys.stderr)
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    root = Path(args.mailbox).expanduser() if args.mailbox else mailbox_root()
    issues = 0
    if not root.exists():
        print(f"doctor: mailbox does not exist: {root}")
        return 0
    inbox = root / "inbox"
    if not inbox.exists():
        print(f"doctor: no inbox/ at {root}")
        return 0

    for proj_dir in sorted(inbox.iterdir()):
        if not proj_dir.is_dir():
            continue
        for state_dir in (proj_dir, proj_dir / ".acked"):
            if not state_dir.exists():
                continue
            for f in sorted(state_dir.iterdir()):
                if not (f.is_file() and f.suffix == ".md"):
                    continue
                try:
                    env, _ = load_message(f)
                    validate(env)
                except (ValidationError, yaml.YAMLError) as e:
                    print(f"BROKEN {f.relative_to(root)}: {e}")
                    issues += 1
                    continue
                expected_acked = (state_dir.name == ".acked")
                if expected_acked and env["ack_state"] != "acked":
                    print(f"INCONSISTENT {f.relative_to(root)}: in .acked/ but ack_state={env['ack_state']}")
                    issues += 1
                elif not expected_acked and env["ack_state"] == "acked":
                    print(f"INCONSISTENT {f.relative_to(root)}: ack_state=acked but in active inbox")
                    issues += 1

    print(f"doctor: {issues} issue(s)", file=sys.stderr)
    return 0 if issues == 0 else 1


def cmd_detect_project(args: argparse.Namespace) -> int:
    cwd = Path(args.from_cwd).expanduser() if args.from_cwd else Path.cwd()
    project = detect_project(cwd)
    if project:
        print(project)
        return 0
    return 1


# ---------------------------------------------------------------- Advisory locks
# Windows locks a byte range, and a locked range cannot be read by another
# process, so the lock byte sits past the PID text a second loop reads.
_WIN_LOCK_OFFSET = 1 << 20


def _try_lock_fd(fd: int) -> bool:
    """Take an exclusive advisory lock on fd without waiting. True when taken.
    The kernel drops it when the holder exits, however it exits (A1)."""
    if fcntl is not None:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            return False
        except OSError as e:
            if e.errno in (errno.EAGAIN, errno.EACCES, errno.EWOULDBLOCK):
                return False
            raise
    if msvcrt is not None:
        pos = os.lseek(fd, 0, os.SEEK_CUR)
        os.lseek(fd, _WIN_LOCK_OFFSET, os.SEEK_SET)
        try:
            msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
            return True
        except OSError:
            return False
        finally:
            os.lseek(fd, pos, os.SEEK_SET)
    return True  # no lock facility on this platform: best effort, never block


def _unlock_fd(fd: int) -> None:
    try:
        if fcntl is not None:
            fcntl.flock(fd, fcntl.LOCK_UN)
        elif msvcrt is not None:
            os.lseek(fd, _WIN_LOCK_OFFSET, os.SEEK_SET)
            msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
    except OSError:
        pass


class FileLock:
    """An advisory lock on an open descriptor. acquire(wait) retries until wait
    seconds pass (0 = one try). After the lock is taken the path is re-checked:
    if a releasing holder unlinked it meanwhile, the lock is on a dead inode and
    the attempt starts again on the new file."""

    def __init__(self, path: Path):
        self.path = path
        self.fd: Optional[int] = None

    def acquire(self, wait: float = 0.0) -> bool:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        deadline = time.monotonic() + wait
        while True:
            fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
            if _try_lock_fd(fd):
                try:
                    same = os.path.samestat(os.fstat(fd), os.stat(self.path))
                except OSError:
                    same = False
                if same:
                    self.fd = fd
                    return True
                _unlock_fd(fd)
            os.close(fd)
            if time.monotonic() >= deadline:
                return False
            time.sleep(random.uniform(0.02, 0.08))

    def write_pid(self) -> None:
        """Diagnostic metadata only; the lock, not this text, is the exclusion."""
        if self.fd is None:
            return
        os.lseek(self.fd, 0, os.SEEK_SET)
        os.ftruncate(self.fd, 0)
        os.write(self.fd, f"{os.getpid()} {socket.gethostname()[:64]}\n".encode("utf-8"))

    def holder_pid(self) -> str:
        try:
            with open(self.path, "r", encoding="utf-8", errors="replace") as f:
                first = (f.read(200).split() or ["?"])[0]
            return first if first.isdigit() else "?"
        except OSError:
            return "?"

    def release(self, remove: bool = False) -> None:
        if self.fd is None:
            return
        fd, self.fd = self.fd, None
        if remove and os.name != "nt":
            # POSIX: unlink while still holding, so no newcomer can lock the old inode
            # and believe it is alone (acquire re-checks the path for the same reason).
            try:
                os.unlink(self.path)
            except OSError:
                pass
        _unlock_fd(fd)
        os.close(fd)
        if remove and os.name == "nt":
            try:  # Windows cannot unlink an open file; a held lock makes this fail harmlessly
                os.unlink(self.path)
            except OSError:
                pass


# ---------------------------------------------------------------- Config / watch setting
def config_path() -> Path:
    return mailbox_root() / ".config.yaml"


class ConfigError(Exception):
    pass


def load_config() -> dict:
    p = config_path()
    try:
        text = p.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise ConfigError(f"cannot read {p}: {e}")
    try:
        cfg = yaml.safe_load(text)
    except yaml.YAMLError as e:
        raise ConfigError(f"{p} is not valid YAML: {e}")
    if cfg is None:
        return {}
    if not isinstance(cfg, dict):
        raise ConfigError(f"{p} is not a YAML mapping")
    return cfg


def watch_enabled(project: str) -> bool:
    """Absent, unreadable or malformed config means off."""
    try:
        watch = load_config().get("watch")
    except ConfigError:
        return False
    return isinstance(watch, dict) and watch.get(project) is True


def set_watch(project: str, on: bool) -> None:
    """Rewrite the config under .config.lock (A5): read, change watch.<project>,
    write a temp file in the mailbox root, os.replace. Every other key is kept;
    comments are not (whole-file YAML round-trip)."""
    root = mailbox_root()
    root.mkdir(parents=True, exist_ok=True)
    lock = FileLock(root / ".config.lock")
    if not lock.acquire(wait=CONFIG_LOCK_WAIT_S):
        raise TimeoutError(f"config lock busy: {root / '.config.lock'}")
    try:
        cfg = load_config()
        watch = cfg.get("watch")
        if not isinstance(watch, dict):
            watch = {}
        watch[project] = bool(on)
        cfg["watch"] = watch
        p = config_path()
        try:
            mode = p.stat().st_mode & 0o777
        except OSError:
            mode = 0o600
        atomic_write_text(p, yaml.safe_dump(cfg, sort_keys=False, default_flow_style=False,
                                            allow_unicode=True), mode=mode)
    finally:
        lock.release()


def cmd_watch(args: argparse.Namespace) -> int:
    project = args.project or detect_project()
    if not project or not PROJECT_PAT.match(project):
        print("cpmail: cannot detect project; pass --project", file=sys.stderr)
        return 2
    if args.action in ("on", "off"):
        try:
            set_watch(project, args.action == "on")
        except (ConfigError, TimeoutError, OSError) as e:
            print(f"cpmail: {e}; watch setting not changed", file=sys.stderr)
            return 1
    print(f"watch: {'on' if watch_enabled(project) else 'off'} for {project}")
    return 0


# ---------------------------------------------------------------- watch-loop
def session_id(explicit: Optional[str]) -> str:
    """--session, else $CLAUDE_CODE_SESSION_ID, else $CLAUDE_SESSION_ID, else the
    parent pid (A2). Never a shared default."""
    for v in (explicit, os.environ.get("CLAUDE_CODE_SESSION_ID"),
              os.environ.get("CLAUDE_SESSION_ID")):
        if v:
            return v
    return f"ppid-{os.getppid()}"


def session_filename_part(sid: str) -> str:
    """A session id reaches a path only when it is plainly safe; anything else is
    hashed (sha256, first 16 hex)."""
    if SESSION_PAT.match(sid) and sid not in (".", ".."):
        return sid
    return "h-" + hashlib.sha256(sid.encode("utf-8", errors="replace")).hexdigest()[:16]


def watch_lock_path(project: str, sid: str) -> Path:
    return mailbox_root() / ".watch" / f"{project}-{session_filename_part(sid)}.lock"


def min_watch_interval() -> float:
    # CPMAIL_WATCH_MIN_INTERVAL lowers the floor for the test suite only.
    try:
        return float(os.environ.get("CPMAIL_WATCH_MIN_INTERVAL", WATCH_MIN_INTERVAL_S))
    except ValueError:
        return WATCH_MIN_INTERVAL_S


class _Terminated(Exception):
    pass


def _on_sigterm(signum, frame):  # noqa: ARG001
    raise _Terminated()


def cmd_watch_loop(args: argparse.Namespace) -> int:
    project = args.project or detect_project()
    if not project or not PROJECT_PAT.match(project):
        print("cpmail: cannot detect project; pass --project", file=sys.stderr)
        return 2
    floor = min_watch_interval()
    if args.interval < floor:
        print(f"cpmail: --interval must be at least {floor:g} seconds", file=sys.stderr)
        return 2
    if not watch_enabled(project):
        print(f"watch is off for {project}")
        return 0

    lock = FileLock(watch_lock_path(project, session_id(args.session)))
    try:
        got = lock.acquire(wait=0.0)
        if got:
            lock.write_pid()
    except OSError as e:
        lock.release(remove=True)
        print(f"cpmail: cannot take the watch lock: {e}", file=sys.stderr)
        return 1
    if not got:
        print(f"already watching (pid {lock.holder_pid()})")
        return EXIT_WATCHING

    parent = os.getppid()
    prev_term = None
    if hasattr(signal, "SIGTERM"):
        try:
            prev_term = signal.signal(signal.SIGTERM, _on_sigterm)
        except ValueError:  # not the main thread (in-process callers)
            prev_term = None
    try:
        while True:
            if os.getppid() != parent:
                return 0  # orphaned: the session that started us is gone (A4)
            if not watch_enabled(project):
                print(f"watch turned off for {project}")
                return 0
            rows = new_message_rows(project)
            if rows:
                print(f"NEW CPMAIL for {project}:")
                for r in rows:
                    print(r)
                return 0
            sys.stdout.flush()
            time.sleep(args.interval)
    except _Terminated:
        return 143
    finally:
        lock.release(remove=True)
        if prev_term is not None:
            try:
                signal.signal(signal.SIGTERM, prev_term)
            except ValueError:
                pass


def cmd_hook_counts(args: argparse.Namespace) -> int:
    """Internal, for the SessionStart hook: one line `<project> <new> <read> <on|off>`.
    One process gives the hook everything it prints."""
    project = args.project or detect_project()
    if not project or not PROJECT_PAT.match(project):
        return 1
    new, read = state_counts(project)
    print(f"{project} {new} {read} {'on' if watch_enabled(project) else 'off'}")
    return 0


# ---------------------------------------------------------------- Main
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="cpmail",
                                description="cross-project-mail v1 — flat-file mailbox")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("send", help="send a message")
    s.add_argument("--to", required=True)
    s.add_argument("--agent", default=None)
    s.add_argument("--subject", required=True)
    s.add_argument("--source-type", dest="source_type", default="human",
                   choices=sorted(SOURCE_TYPES))
    s.add_argument("--reply-to", dest="reply_to", default=None)
    s.add_argument("--thread-id", dest="thread_id", default=None)
    s.add_argument("--label", action="append", default=[])
    s.add_argument("--from", dest="from_", default=None,
                   help="'@path/to/file' or omit to read stdin")
    s.add_argument("--from-project", dest="from_project", default=None)
    s.add_argument("--sender-agent", dest="sender_agent", default="unknown",
                   choices=sorted(AGENTS))
    s.add_argument("--dedupe", action="store_true",
                   help=f"refuse (exit {EXIT_DUPLICATE}) if an unacked message from this "
                        "project to --to has the same dedupe key")
    s.add_argument("--dedupe-key", dest="dedupe_key", default=None,
                   help="topic key for --dedupe (implies it); default: the normalised subject")

    s = sub.add_parser("list", help="list messages")
    s.add_argument("--project", default=None)
    g = s.add_mutually_exclusive_group()
    g.add_argument("--unread", action="store_true",
                   help="everything not acked (unread and read); the default")
    g.add_argument("--new", action="store_true",
                   help="only messages never opened (ack_state unread)")
    g.add_argument("--acked", action="store_true")
    g.add_argument("--all", action="store_true")
    s.add_argument("--limit", type=int, default=None)
    s.add_argument("--since", default=None)

    s = sub.add_parser("read", help="read a message")
    s.add_argument("msg_id")

    s = sub.add_parser("ack", help="acknowledge a message")
    s.add_argument("msg_id")

    s = sub.add_parser("migrate", help="migrate cross-repo-review.md -> mailbox")
    s.add_argument("--from", dest="from_", required=True)
    s.add_argument("--sender-project", dest="sender_project", default=None)
    s.add_argument("--dry-run", dest="dry_run", action="store_true")

    s = sub.add_parser("doctor", help="validate mailbox layout")
    s.add_argument("--mailbox", default=None)

    s = sub.add_parser("_detect-project", help="(internal) print detected project")
    s.add_argument("--from-cwd", dest="from_cwd", default=None)

    s = sub.add_parser("watch", help="per-project watch setting: on, off or status")
    s.add_argument("action", choices=["on", "off", "status"])
    s.add_argument("--project", default=None)

    s = sub.add_parser("watch-loop",
                       help="wait for new mail; exit 0 with the rows when it arrives")
    s.add_argument("--project", default=None)
    s.add_argument("--interval", type=float, default=WATCH_DEFAULT_INTERVAL_S,
                   help=f"seconds between checks (default {WATCH_DEFAULT_INTERVAL_S:g}, "
                        f"min {WATCH_MIN_INTERVAL_S:g})")
    s.add_argument("--session", default=None,
                   help="session id (default $CLAUDE_CODE_SESSION_ID, $CLAUDE_SESSION_ID, "
                        "else the parent pid)")

    s = sub.add_parser("_hook-counts", help="(internal) project, new, read, watch for the hook")
    s.add_argument("--project", default=None)

    return p


def main(argv: Optional[list[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    dispatch = {
        "send": cmd_send, "list": cmd_list, "read": cmd_read, "ack": cmd_ack,
        "migrate": cmd_migrate, "doctor": cmd_doctor,
        "_detect-project": cmd_detect_project,
        "watch": cmd_watch, "watch-loop": cmd_watch_loop,
        "_hook-counts": cmd_hook_counts,
    }
    return dispatch[args.cmd](args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ValidationError as e:
        print(f"cpmail: {e}", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
