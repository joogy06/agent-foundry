#!/usr/bin/env bash
# bridge-init — create a new session on the bridge repo.
#
# Usage: bridge init [--repo <url>] [--caller <name>] [--caller-version <ver>]
#
# Steps:
#   1. Resolve BRIDGE_REPO_URL (from --repo, env, or `git config --global bridge.repo`).
#   2. Verify `gh` is authenticated and that the repo is PRIVATE (SEC-7).
#   3. Clone or update the bridge repo under $BRIDGE_LOCAL_WORKSPACE.
#   4. Generate SESSION_ID (128 bits entropy) and check for remote collision (M16).
#   5. Create orphan branch session/<id>, wipe everything, copy workflow templates.
#   6. Write .bridge/ metadata files.
#   7. Commit and push.
#   8. Cache the session id in $BRIDGE_CACHE_DIR/current-session.

set -euo pipefail

BRIDGE_SELF_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)"
# shellcheck disable=SC1091
. "$BRIDGE_SELF_DIR/bridge-env.sh"

# -------- arg parsing --------
CALLER="${BRIDGE_CALLER:-manual}"
CALLER_VERSION="${BRIDGE_CALLER_VERSION:-0.0.0}"
REPO_URL_OVERRIDE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)           REPO_URL_OVERRIDE="$2"; shift 2 ;;
    --caller)         CALLER="$2"; shift 2 ;;
    --caller-version) CALLER_VERSION="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,15p' "$0" >&2
      exit 0
      ;;
    *)
      bridge_err "unknown option: $1"
      exit 1
      ;;
  esac
done

bridge_require git openssl gh || exit 1

# -------- resolve repo URL --------
if [ -n "$REPO_URL_OVERRIDE" ]; then
  REPO_URL="$REPO_URL_OVERRIDE"
else
  REPO_URL="$(bridge_repo_url || true)"
  if [ -z "$REPO_URL" ]; then
    bridge_err "no bridge repo configured."
    bridge_err "run: git config --global bridge.repo <url>"
    bridge_err "  or pass: bridge init --repo <url>"
    exit 1
  fi
fi

# Extract owner/repo from URL for gh api check.
# Supports git@github.com:owner/repo.git and https://github.com/owner/repo(.git)
OWNER_REPO="$(printf '%s' "$REPO_URL" | sed -E \
  -e 's#^git@github.com:##' \
  -e 's#^https?://github.com/##' \
  -e 's#\.git$##')"
if [ -z "$OWNER_REPO" ] || [ "$OWNER_REPO" = "$REPO_URL" ]; then
  bridge_err "could not parse owner/repo from URL: $REPO_URL"
  exit 1
fi

# -------- SEC-7 privacy check --------
bridge_info "verifying bridge repo is private (SEC-7)..."
if ! private_flag="$(gh api "repos/$OWNER_REPO" --jq .private 2>/dev/null)"; then
  bridge_err "could not fetch repo metadata for $OWNER_REPO. Is gh authenticated?"
  exit 2
fi
if [ "$private_flag" != "true" ]; then
  bridge_err "bridge repo $OWNER_REPO is NOT private. SEC-7 violation. Refusing."
  bridge_err "fix: gh repo edit $OWNER_REPO --visibility private"
  exit 2
fi
bridge_info "bridge repo is private. Continuing."

# -------- clone or update local workspace --------
WORKSPACE="$BRIDGE_LOCAL_WORKSPACE/$(basename "$OWNER_REPO")"
if [ ! -d "$WORKSPACE/.git" ]; then
  bridge_info "cloning $REPO_URL into $WORKSPACE"
  git clone --quiet "$REPO_URL" "$WORKSPACE"
else
  bridge_info "updating existing clone at $WORKSPACE"
  ( cd "$WORKSPACE" && git fetch --quiet origin main )
fi
cd "$WORKSPACE"

# Make sure main is checked out and up to date for template copy.
git checkout -q main 2>/dev/null || git checkout -q -b main origin/main
git pull --quiet origin main

# -------- generate session id with collision check (M16) --------
gen_session_id() {
  printf '%s-%s' "$(date -u +%Y%m%d-%H%M)" "$(openssl rand -hex 16)"
}

SESSION_ID=""
for attempt in 1 2 3; do
  candidate="$(gen_session_id)"
  if ! git ls-remote --exit-code origin "refs/heads/session/$candidate" >/dev/null 2>&1; then
    SESSION_ID="$candidate"
    break
  fi
  bridge_warn "session id collision on attempt $attempt, retrying"
done
if [ -z "$SESSION_ID" ]; then
  bridge_err "could not generate unique session id after 3 attempts"
  exit 1
fi
BRANCH="session/$SESSION_ID"
bridge_info "creating orphan branch $BRANCH"

# -------- orphan branch, wipe, copy templates --------
# Save the main tree snapshot for .github/ template copy.
TEMPLATE_SRC="$(mktemp -d /tmp/bridge-templates-XXXXXX)"
trap 'rm -rf "$TEMPLATE_SRC"' EXIT
cp -a .github "$TEMPLATE_SRC/" 2>/dev/null || true
MAIN_SETUP_VERSION="$(cat .bridge/setup-version 2>/dev/null || echo 1)"

git checkout -q --orphan "$BRANCH"
git rm -rfq . 2>/dev/null || true
rm -rf -- * .[!.]* 2>/dev/null || true  # belt and suspenders

mkdir -p .github .bridge
if [ -d "$TEMPLATE_SRC/.github" ]; then
  cp -a "$TEMPLATE_SRC/.github/." .github/
fi

# -------- .bridge/ metadata --------
printf '%s\n' "$SESSION_ID"              > .bridge/session-id
date -u +%FT%TZ                          > .bridge/created-at
printf '%s\n' "$MAIN_SETUP_VERSION"      > .bridge/workflow-version
printf '%s\n' "$BRIDGE_CLIENT_VERSION"   > .bridge/client-version
cat > .bridge/caller.json <<EOF
{
  "caller": "$CALLER",
  "version": "$CALLER_VERSION",
  "hostname": "$(hostname -s 2>/dev/null || echo unknown)",
  "parent_session": "$(bridge_session_tag)"
}
EOF

cat > README-SESSION.md <<EOF
# Bridge session: $SESSION_ID

This is an ephemeral orphan branch created by \`bridge init\`. It will be
archived and pruned automatically after 7 days of inactivity by
\`bridge-maintenance.yml\`. Do NOT merge this branch into \`main\`.

Created at: $(date -u +%FT%TZ)
Caller: $CALLER/$CALLER_VERSION
EOF

# -------- commit and push --------
git add -A
git -c user.email="bridge-client@local" -c user.name="bridge-client" \
  commit -q -m "bridge: init session $SESSION_ID [skip ci]"
git push -q -u origin "$BRANCH"

# -------- cache current session --------
bridge_set_current_session "$SESSION_ID"

# -------- success summary --------
printf '%s\n' "$SESSION_ID"
bridge_info "session ready. Use: bridge request ..."
bridge_info "branch URL: https://github.com/$OWNER_REPO/tree/$BRANCH"
