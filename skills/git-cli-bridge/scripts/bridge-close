#!/usr/bin/env bash
# bridge-close — archive-tag and delete the current session branch.
# Usage: bridge close [--force] [--no-archive]
set -euo pipefail
BRIDGE_SELF_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)"
# shellcheck disable=SC1091
. "$BRIDGE_SELF_DIR/bridge-env.sh"

FORCE=0
ARCHIVE=1
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1 ;;
    --no-archive) ARCHIVE=0 ;;
    -h|--help) sed -n '2,4p' "$0" >&2; exit 0 ;;
    *) bridge_err "unknown: $arg"; exit 1 ;;
  esac
done

bridge_require git jq || exit 1
SESSION_ID="$(bridge_current_session)" || { bridge_err "no current session"; exit 1; }
REPO_URL="$(bridge_repo_url)" || { bridge_err "no bridge repo configured"; exit 1; }
OWNER_REPO="$(printf '%s' "$REPO_URL" | sed -E -e 's#^git@github.com:##' -e 's#^https?://github.com/##' -e 's#\.git$##')"
WORKSPACE="$BRIDGE_LOCAL_WORKSPACE/$(basename "$OWNER_REPO")"
cd "$WORKSPACE"

BRANCH="session/$SESSION_ID"
git fetch -q origin "$BRANCH" 2>/dev/null || true
git checkout -q "$BRANCH" 2>/dev/null || true
git reset -q --hard "origin/$BRANCH" 2>/dev/null || true

# Running-state guard.
running_count=0
if [ -d requests ]; then
  while IFS= read -r s; do
    state="$(jq -r '.state // ""' "$s" 2>/dev/null || true)"
    [ "$state" = "running" ] && running_count=$((running_count + 1))
  done < <(find requests -name status.json -type f)
fi
if [ "$running_count" -gt 0 ] && [ "$FORCE" -eq 0 ]; then
  bridge_err "$running_count running requests — use --force to override"
  exit 1
fi

if [ "$ARCHIVE" -eq 1 ]; then
  TAG="archive/session/${SESSION_ID}-$(date -u +%Y%m%d)"
  git tag -f "$TAG" "origin/$BRANCH" 2>/dev/null || true
  git push -q origin "$TAG" 2>/dev/null || true
  bridge_info "archive tag pushed: $TAG"
fi

# Switch away from the branch before deleting locally.
git checkout -q main 2>/dev/null || git checkout -q --detach HEAD
git branch -D "$BRANCH" 2>/dev/null || true
git push -q origin --delete "$BRANCH" 2>/dev/null || bridge_warn "remote branch delete failed (may not exist)"

bridge_clear_current_session
bridge_info "session $SESSION_ID closed"
