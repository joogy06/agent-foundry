#!/usr/bin/env bash
# bridge-logs — tail workflow logs for a request via gh run view.
# Usage: bridge logs <req-id>
set -euo pipefail
BRIDGE_SELF_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)"
# shellcheck disable=SC1091
. "$BRIDGE_SELF_DIR/bridge-env.sh"

REQ_ID="${1:-}"
[ -n "$REQ_ID" ] || { bridge_err "usage: bridge logs <req-id>"; exit 1; }

bridge_require git jq gh || exit 1
SESSION_ID="$(bridge_current_session)" || { bridge_err "no current session"; exit 1; }
REPO_URL="$(bridge_repo_url)" || { bridge_err "no bridge repo configured"; exit 1; }
OWNER_REPO="$(printf '%s' "$REPO_URL" | sed -E -e 's#^git@github.com:##' -e 's#^https?://github.com/##' -e 's#\.git$##')"
WORKSPACE="$BRIDGE_LOCAL_WORKSPACE/$(basename "$OWNER_REPO")"
cd "$WORKSPACE"

REQ_DIR="requests/$REQ_ID"
RUN_ID=""
for f in response.md error.md status.json; do
  if [ -f "$REQ_DIR/$f" ]; then
    case "$f" in
      status.json)
        RUN_ID="$(jq -r '.workflow_run_id // ""' "$REQ_DIR/$f")" ;;
      *)
        RUN_ID="$(awk '/^workflow_run_id:/ {print $2; exit}' "$REQ_DIR/$f" | tr -d '"')" ;;
    esac
    [ -n "$RUN_ID" ] && [ "$RUN_ID" != "null" ] && break
  fi
done

if [ -z "$RUN_ID" ] || [ "$RUN_ID" = "null" ]; then
  bridge_err "no workflow_run_id found for $REQ_ID"
  exit 1
fi

# Pipe through the same sanitizer we use for response bodies.
gh run view "$RUN_ID" --log --repo "$OWNER_REPO" \
  | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' \
  | tr -d '\000-\010\013\014\016-\037\177' \
  | iconv -f UTF-8 -t UTF-8 -c
