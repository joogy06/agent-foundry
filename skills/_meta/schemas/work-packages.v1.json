{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-factory.local/schemas/work-packages.v1.json",
  "title": "work-packages.v1",
  "description": "S055 workflow-adoption keystone (§6.2). The host-neutral DATA plan bob materializes at progress/work-packages.yaml and HALTs with `needs: plan-execution`. Writer: bob (atomic, revision-bumped on amendment). NEVER executable code (S052 provenance). Consumed by the main-loop compiler, bob stages, agent-teams, fallback callers, and vs-code-foundry serially.",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "project_root",
    "design_doc",
    "design_doc_hash",
    "contract_map",
    "generated_by",
    "generated_at",
    "work_packages"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "work-packages.v1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Revision bump => new plan_hash => all caches invalid (resume across amendment structurally impossible)."
    },
    "project_root": { "type": "string", "minLength": 1 },
    "design_doc": { "type": "string", "minLength": 1 },
    "design_doc_hash": {
      "type": "string",
      "description": "sha256 of the design doc; the compiler REFUSES on hash mismatch.",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "contract_map": {
      "type": "object",
      "description": "`{path, hash, revision, classification}`. For N/A cycles, path/hash/revision carry the literal \"N/A\" and classification names the artifact.",
      "required": ["path", "hash", "revision", "classification"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "hash": { "type": "string" },
        "revision": { "type": ["integer", "string"] },
        "classification": { "type": "string" }
      }
    },
    "generated_by": { "const": "bob" },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "constraints": {
      "type": "object",
      "description": "#147 design half — recorded, not enforced this cycle.",
      "additionalProperties": true,
      "properties": {
        "max_teams": { "type": "integer", "minimum": 1 },
        "max_agents_per_team": { "type": "integer", "minimum": 1 },
        "token_budget": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "shared_context": {
      "type": "object",
      "description": "codebase summary, style guide, arch docs — host-neutral data.",
      "additionalProperties": true
    },
    "work_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "goal",
          "files",
          "acceptance_criteria",
          "dependencies",
          "complexity",
          "executor"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Checkable statements feeding test plans + finalize (NEW in v1)."
          },
          "skills": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "complexity": { "enum": ["S", "M", "L"] },
          "component_id": { "type": ["string", "null"] },
          "executor": {
            "enum": ["worker", "bob"],
            "description": "`worker` REQUIRES machinery:[] AND worktree_ok:true (cross-constraint below). Default when unsure: bob (fails safe, serial)."
          },
          "machinery": {
            "type": "array",
            "items": { "enum": ["ledger", "gates", "trusted_runner", "claims"] },
            "description": "Non-empty => worktree_ok:false mandatory."
          },
          "worktree_ok": { "type": "boolean" },
          "team_plan": {
            "type": "object",
            "description": "agent-teams POLICY output, embedded verbatim. `backend_hint` is a snapshot; the main loop re-checks.",
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "$comment": "fix #5: executor:worker => machinery empty AND worktree_ok true.",
            "if": { "properties": { "executor": { "const": "worker" } } },
            "then": {
              "properties": {
                "machinery": { "maxItems": 0 },
                "worktree_ok": { "const": true }
              },
              "required": ["worktree_ok"]
            }
          },
          {
            "$comment": "machinery non-empty => worktree_ok false mandatory.",
            "if": {
              "properties": { "machinery": { "minItems": 1 } },
              "required": ["machinery"]
            },
            "then": {
              "properties": { "worktree_ok": { "const": false } },
              "required": ["worktree_ok"]
            }
          }
        ]
      }
    },
    "team_plan": {
      "type": "object",
      "description": "Top-level agent-teams POLICY output {topology, parallelism_ratio, teams[], backend_hint}.",
      "additionalProperties": true
    }
  }
}
