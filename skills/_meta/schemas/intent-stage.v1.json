{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-factory.local/schemas/intent-stage.v1.json",
  "title": "intent-stage.v1",
  "description": "S055 §5.7 — output of an evo-analyze `intent` pipeline stage (intent-extract runs UNCHANGED including its internal two_arm_verify.py — the canonical HR7 arm). Owner: evo. Consumed by the evo-analyze script + the cold-audit stage.",
  "type": "object",
  "required": ["component_id", "confidence_level"],
  "additionalProperties": false,
  "properties": {
    "component_id": { "type": "string", "minLength": 1 },
    "confidence_level": { "enum": ["grounded", "interpretive"] },
    "intent_path": { "type": ["string", "null"], "description": "functional-intent.v1 output path." },
    "evidence_edges_resolved": { "type": "boolean" },
    "skipped": { "type": "array", "items": { "type": "string" } }
  }
}
