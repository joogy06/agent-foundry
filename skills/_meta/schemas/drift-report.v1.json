{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry-lab.local/schemas/drift-report.v1.json",
  "title": "drift-report.v1",
  "description": "S032 EVO drift-report.yaml produced at DRIFT_SURFACED phase. Aggregates dep-currency-check findings (CVE + version_lag) with intent-derived api_break warnings + advisory optimization_suggestion entries. Consumed by user (consultation) and bob (APPLY handoff).",
  "type": "object",
  "required": [
    "schema_version", "run_id", "generated_at", "project_root", "mode", "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "format": "uuid" },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "project_root": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": ["intent-map-only", "version-upgrade", "cve-fix"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "severity", "package", "recommendation",
                     "requires_user_decision", "blocking"],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^f-[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "api_break", "cve", "version_lag", "test_gap",
              "optimization_suggestion"
            ]
          },
          "severity": {
            "enum": ["critical", "high", "moderate", "low"]
          },
          "package": { "type": "string", "minLength": 1 },
          "declared_version": { "type": "string" },
          "latest_stable": { "type": "string" },
          "cves": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cve_id": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]+$" },
          "fix_category": {
            "enum": [
              "direct-fix-available", "override-possible",
              "upstream-blocked", "workaround-required", "no-known-fix"
            ]
          },
          "fix_path": { "type": "string" },
          "api_delta_summary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "breaking_lines": {
                "type": "array",
                "items": { "type": "string" }
              },
              "affected_call_sites": { "type": "integer", "minimum": 0 },
              "affected_components": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "recommendation": { "type": "string", "minLength": 1 },
          "requires_user_decision": { "type": "boolean" },
          "blocking": { "type": "boolean" },
          "rationale": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical_count": { "type": "integer", "minimum": 0 },
        "blocking_count": { "type": "integer", "minimum": 0 },
        "components_touched": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
