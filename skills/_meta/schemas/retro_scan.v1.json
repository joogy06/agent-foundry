{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-factory.local/schemas/retro_scan.v1.json",
  "title": "retro_scan.v1",
  "description": "S029 retro-scan-s028 baseline output. Frozen one-shot snapshot of the workspace classified against the contract-map at a specific revision. Consumed by G_CONTRACT_SCOPE during #45 Phase-5b execution to determine whether a delta is new (block) vs pre-existing (advisory).",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "generated_by",
    "contract_map_hash",
    "contract_map_revision",
    "components",
    "baseline_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "retro_scan.v1"},
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "generated_by": {
      "type": "string",
      "const": "retro-scan-s028"
    },
    "contract_map_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contract_map_revision": {
      "type": "integer",
      "minimum": 0
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "declared_source_paths", "actual_paths", "findings"],
        "additionalProperties": false,
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "declared_source_paths": {
            "type": "array",
            "items": {"type": "string"}
          },
          "actual_paths": {
            "type": "array",
            "items": {"type": "string"}
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "artifact_kind", "in_declared", "severity"],
              "additionalProperties": true,
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "artifact_kind": {
                  "type": "string",
                  "enum": [
                    "secret", "db_migration", "env_var", "public_api",
                    "config_key", "generated_artifact", "file"
                  ]
                },
                "in_declared": {"type": "boolean"},
                "in_declared_capability": {"type": "boolean"},
                "severity": {
                  "type": "string",
                  "enum": ["pre_existing", "pre_existing_critical", "pre_existing_advisory"]
                },
                "resolution": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    },
    "baseline_summary": {
      "type": "object",
      "required": [
        "total_findings",
        "pre_existing",
        "pre_existing_critical",
        "pre_existing_advisory",
        "newly_introduced"
      ],
      "additionalProperties": false,
      "properties": {
        "total_findings": {"type": "integer", "minimum": 0},
        "pre_existing": {"type": "integer", "minimum": 0},
        "pre_existing_critical": {"type": "integer", "minimum": 0},
        "pre_existing_advisory": {"type": "integer", "minimum": 0},
        "newly_introduced": {"type": "integer", "minimum": 0}
      }
    },
    "baseline_critical_paths": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Q2 #4: paths that ALWAYS block recurrence regardless of pre-existing status."
    }
  }
}
