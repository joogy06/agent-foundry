#!/usr/bin/env bash
# SUPERSEDED by pre_commit.py (#250). Kept as the reference implementation the
# port is measured against -- tests/hooks/ runs every scenario against both.
# pre-commit — refuse a commit that stages secret-looking values.
#
# Delegates to scripts/secrets-scan.py --staged, which reads content from the GIT
# INDEX (not the worktree), so it scans exactly what is about to be committed.
# Sharing that scanner is the point: the commit hook, the pre-push hook and the
# G_SECRETS_SCAN gate all enforce ONE pattern set and cannot drift apart.
#
# Install: bash skills/secret-scanning/hooks/install.sh
set -uo pipefail

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
scanner="$repo_root/scripts/secrets-scan.py"

# Fall back to the skill copy so the hook works in repos that don't vendor the scanner.
[ -f "$scanner" ] || scanner="$HOME/.claude/skills/secret-scanning/scripts/secrets-scan.py"

if [ ! -f "$scanner" ]; then
  # install.sh refuses to install when no scanner resolves, so reaching here means
  # the scanner was REMOVED after install. Fail CLOSED: an enforcement hook that
  # silently skips is worse than no hook, because it advertises protection that is
  # not there. Explicit --no-verify remains the escape hatch.
  echo "pre-commit: BLOCKED — secrets scanner missing." >&2
  echo "  expected: \$repo/scripts/secrets-scan.py or ~/.claude/skills/secret-scanning/scripts/secrets-scan.py" >&2
  echo "  Restore it, or bypass deliberately with: git commit --no-verify" >&2
  exit 1
fi

py=$(command -v python3 || command -v python) || {
  echo "pre-commit: no python found; skipping secrets scan" >&2; exit 0; }

# --- SKILL.md frontmatter (#237) ---------------------------------------------
# Claude Code's loader tolerates YAML that yaml.safe_load and Codex CLI reject, so a
# broken skill is invisible here and missing THERE. This has landed twice (llm-security
# S040, career-advocacy S074) — both times the file was fixed and the cause was not.
# Advisory on warnings, blocking on parse/name errors.
linter="$repo_root/skills/_meta/frontmatter_lint.py"
[ -f "$linter" ] || linter="$HOME/.claude/skills/_meta/frontmatter_lint.py"
if [ -f "$linter" ]; then
  staged_skills=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)SKILL\.md$' || true)
  if [ -n "$staged_skills" ]; then
    # shellcheck disable=SC2086
    fm_out=$("$py" "$linter" check $staged_skills 2>&1)
    if printf '%s' "$fm_out" | grep -qE '^  E[0-9]'; then
      echo "$fm_out" >&2
      echo "" >&2
      echo "pre-commit: BLOCKED — a staged SKILL.md has invalid frontmatter." >&2
      echo "  Commonest cause: an unquoted ': ' inside a value. Quote the value." >&2
      echo "  Bypass deliberately with: git commit --no-verify" >&2
      exit 1
    fi
    printf '%s' "$fm_out" | grep -qE '^  W[0-9]' && echo "$fm_out" >&2
  fi
fi
# -----------------------------------------------------------------------------
# Portability lint (#249/#251) — staged .py only.
#
# `check` deliberately sees ONLY staged files. A tree-wide gate would block every
# commit on the ~600 pre-existing W002 sites, and a check that fires on work you
# did not do is how people learn to reach for --no-verify. This stops the bleeding
# instead: a NEW unguarded platform-only import, or a NEW entrypoint that emits
# non-ASCII without hardening its streams, does not enter the tree.
#
# E blocks, W is printed and allowed. The nine known import-fatal modules (#249)
# will block a commit that touches them — that is deliberate, and clearing it is
# what #249 is for.
# -----------------------------------------------------------------------------
plint="$repo_root/skills/_meta/portability_lint.py"
[ -f "$plint" ] || plint="$HOME/.claude/skills/_meta/portability_lint.py"
if [ -f "$plint" ]; then
  staged_py=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
  if [ -n "$staged_py" ]; then
    # shellcheck disable=SC2086
    pl_out=$("$py" "$plint" check $staged_py 2>&1)
    if printf '%s' "$pl_out" | grep -qE '^E[0-9]'; then
      echo "$pl_out" >&2
      echo "" >&2
      echo "pre-commit: BLOCKED — a staged .py breaks on another platform." >&2
      echo "  E001: guard the import (try/except ImportError), defer it into the" >&2
      echo "  function, or branch on sys.platform. An unguarded platform-only import" >&2
      echo "  fails at IMPORT, so it takes down every caller, not just the code path." >&2
      echo "  Bypass deliberately with: git commit --no-verify" >&2
      exit 1
    fi
    printf '%s' "$pl_out" | grep -qE '^W[0-9]' && echo "$pl_out" >&2
  fi
fi
# -----------------------------------------------------------------------------

"$py" "$scanner" "$repo_root" --staged
status=$?

if [ $status -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: BLOCKED — staged content matches a secret pattern." >&2
  echo "  Move the value to ~/.secrets/<project>.env (0600) and load it at runtime." >&2
  echo "  See: skills/secret-scanning/references/storage-standard.md" >&2
  echo "  If the credential was ever committed, ROTATE it — scrubbing is not rotation." >&2
fi
exit $status
