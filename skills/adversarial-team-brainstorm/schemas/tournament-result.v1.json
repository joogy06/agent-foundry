{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-factory.local/schemas/tournament-result.v1.json",
  "title": "tournament-result.v1",
  "description": "S055 §5.5 — output of the single `arbiter` stage. Owner: adversarial-team-brainstorm. Script post-check: empty grounding_sources => confidence FORCED 'speculative' (the script may DOWNGRADE confidence, NEVER upgrade). Below-floor before refine => meta.degraded_to: 'quick_tournament', confidence capped 'low'. Consumed by the tournament script + caller.",
  "type": "object",
  "required": ["ranked_outputs", "meta"],
  "additionalProperties": false,
  "properties": {
    "ranked_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["team_id", "rank", "kill_criteria", "confidence"],
        "additionalProperties": false,
        "properties": {
          "team_id": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "synthesis": { "type": "string" },
          "kill_criteria": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "first_experiment": { "type": ["string", "null"] },
          "grounding_sources": { "type": "array", "items": { "type": "string" } },
          "confidence": { "enum": ["speculative", "low", "medium", "high"] }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [],
      "additionalProperties": true,
      "properties": {
        "degraded_to": { "type": ["string", "null"], "description": "e.g. quick_tournament when refine was skipped (below floor)." }
      }
    }
  }
}
